# Optional. Copy to .env (gitignored) when using Postgres or a non-Fake LLM.
# Compose sets DELPHI_DATABASE_URL itself. `scripts/compose-up.sh` copies this file.

DELPHI_DATABASE_URL=
DELPHI_API_KEY=change-me
POSTGRES_PASSWORD=delphi
DELPHI_LLM_KIND=fake
DELPHI_LLM_MODEL=
DELPHI_LLM_EMBEDDING_MODEL=
DELPHI_LLM_BASE_URL=
DELPHI_LLM_API_KEY=
DELPHI_MAILTO=delphi-engine@localhost

# EPO OPS: https://developers.epo.org/ — consumer key + secret
EPO_OPS_KEY=
EPO_OPS_SECRET=
# WIPO has no public REST search; paid SOAP or a JSON gateway URL + key
WIPO_API_KEY=
WIPO_PATENTSCOPE_URL=
# PatSnap Open Platform (commercial Bearer key, often sk-...)
PATSNAP_API_KEY=
# Lens.org patent API token
LENS_API_TOKEN=
# PatentsView: register at https://patentsview.org/ and send X-Api-Key
PATENTSVIEW_API_KEY=
DELPHI_TEST_DATABASE_URL=postgresql://delphi:delphi@127.0.0.1:5432/delphi_test
